<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quantumforge.ragbot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/mivallion/source/repos/courses/architecture/architecture-pro-quantumforge/venv/bin/python</string>
        <string>-m</string>
        <string>app.bot</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mivallion/source/repos/courses/architecture/architecture-pro-quantumforge</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HF_HUB_OFFLINE</key>
        <string>1</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>TOKENIZERS_PARALLELISM</key>
        <string>false</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/mivallion/source/repos/courses/architecture/architecture-pro-quantumforge/Task6/logs/bot.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mivallion/source/repos/courses/architecture/architecture-pro-quantumforge/Task6/logs/bot.stderr.log</string>
</dict>
</plist>
